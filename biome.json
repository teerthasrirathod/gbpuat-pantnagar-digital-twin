{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": { "includes": ["apps/**/*.ts", "apps/**/*.json", "scripts/**/*.mjs", "e2e/**/*.ts", "!**/node_modules", "!**/dist", "!apps/web/public/data"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 140 },
  "linter": { "enabled": true, "rules": { "recommended": true } },
  "overrides": [
    { "includes": ["apps/web/src/scene/**/*.ts", "apps/web/src/render/**/*.ts"], "linter": { "rules": { "suspicious": { "noExplicitAny": "off" } } } }
  ]
}
