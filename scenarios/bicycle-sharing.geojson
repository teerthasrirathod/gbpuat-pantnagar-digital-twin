 "sandbox": {
  "version": 1,
  "tool": "Pantnagar Sandbox",
  "title": "Public bicycle sharing",
  "theme": "Public Bicycle Sharing System",
  "team": "",
  "members": "",
  "mentor": "",
  "problem": "Hostels, colleges, the library and the market are up to 2 km apart, while many bicycles lie abandoned around hostels. Students without a bicycle walk long distances or depend on lifts.",
  "objectives": "Refurbish abandoned bicycles and put them back into use.\nA bicycle dock within a 5-minute walk (300 m) of every hostel and college.",
  "outcomes": "",
  "sustainability": "A small semester fee covers spares; a student society runs repairs; more abandoned bicycles join the fleet every year.",
  "wifi_targets": [
   "hostel"
  ],
  "wifi_buildings": [],
  "costs": {
   "bike_dock": 7000
  },
  "assumptions": {},
  "summary": "Docks for refurbished abandoned bicycles beside every hostel and college, the library, the stadium and the market.",
  "implementation": "1. Collect and list abandoned bicycles with the hostel wardens; repair the usable ones in a student workshop.\n2. Build simple racks with locks at the dock sites; number every bicycle.\n3. Start a sign-out system with the student ID card (paper register first, app later).\n4. Review use after one semester and move docks where demand is."
 },
